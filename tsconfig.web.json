{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@resources/*": ["resources/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/index.html",
    "src/renderer/exportSubtitle.html",
    "src/shared/**/*",
    "src/preload/index.d.ts"
  ]
}
